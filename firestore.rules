rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /hamms/mainData {
      allow read, write: if request.auth != null;
    }
    match /hammsStores/{store}/records/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && store in ['wo','assets','inventory','issuance','waste','safety',
                     'projects','waterLogs','waterTank','effluent',
                     'medWasteProd','wwProd','censusLog','waterSettings']
        && request.resource.data.keys().size() < 100
        && (!('_v' in request.resource.data) || request.resource.data._v is int)
        && (!('_updatedAt' in request.resource.data) || request.resource.data._updatedAt is int);
    }
    match /hammsMeta/state {
      allow read, write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
