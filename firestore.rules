rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isNamedUser() { return request.auth != null && request.auth.token.email != null; }
    function isAdmin() { return isNamedUser() && request.auth.token.get('admin', false) == true; }
    function validStore(store) {
      return store in ['wo','assets','inventory','issuance','waste','safety','projects',
        'waterLogs','waterTank','effluent','medWasteProd','wwProd','censusLog','waterSettings','energyBills','locations'];
    }
    function validRecord(docId) {
      return request.resource.data.keys().size() < 100
        && request.resource.data._docId == docId
        && request.resource.data._v is int
        && request.resource.data._updatedAt is int
        && request.resource.data._updatedBy == request.auth.token.email;
    }
    function validBillFactor(store, metaRoot) {
      let incoming = request.resource.data.get('carbonFactor', null);
      return store != 'energyBills' || incoming == null
        || (resource != null && incoming == resource.data.get('carbonFactor', null))
        || (incoming is map && incoming.id is string
          && incoming == getAfter(/databases/$(database)/documents/$(metaRoot)/state).data
            .get('energySettings', {}).get('factorById', {}).get(incoming.id, null));
    }
    match /hamms/mainData {
      allow read: if isNamedUser();
      allow delete: if isAdmin();
      allow create, update: if false;
    }
    match /{storeRoot}/{store}/records/{docId} {
      allow read: if isNamedUser() && storeRoot in ['hammsStores', 'hammsStores_staging'] && validStore(store);
      allow create: if isNamedUser() && storeRoot in ['hammsStores', 'hammsStores_staging'] && validStore(store) && validRecord(docId) && validBillFactor(store, storeRoot == 'hammsStores_staging' ? 'hammsMeta_staging' : 'hammsMeta')
        && request.resource.data._v == 1;
      allow update: if isNamedUser() && storeRoot in ['hammsStores', 'hammsStores_staging'] && validStore(store) && validRecord(docId) && validBillFactor(store, storeRoot == 'hammsStores_staging' ? 'hammsMeta_staging' : 'hammsMeta')
        && request.resource.data._v == resource.data.get('_v', 0) + 1;
      // Operational records are shared: any authorized staff member may delete.
      allow delete: if isNamedUser() && storeRoot in ['hammsStores', 'hammsStores_staging'] && validStore(store);
    }
    match /{metaRoot}/state {
      allow read: if isNamedUser() && metaRoot in ['hammsMeta', 'hammsMeta_staging'];
      allow create: if isNamedUser() && metaRoot in ['hammsMeta', 'hammsMeta_staging'] && validMeta()
        && (isAdmin() || !request.resource.data.keys().hasAny(['resetAt','restoreAt','energySettings','legacyMigrations']));
      allow update: if isNamedUser() && metaRoot in ['hammsMeta', 'hammsMeta_staging'] && validMeta()
        && (isAdmin() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['resetAt','restoreAt','energySettings','legacyMigrations']));
      allow delete: if isAdmin() && metaRoot in ['hammsMeta', 'hammsMeta_staging'];
      function validMeta() {
        return request.resource.data.keys().size() < 50
          && request.resource.data.updatedBy == request.auth.token.email
          && (!('inpatientToday' in request.resource.data)
              || (request.resource.data.inpatientToday is int && request.resource.data.inpatientToday >= 0));
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
