rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: require a named (non-anonymous) user
    function isNamedUser() {
      return request.auth != null && request.auth.token.email != null;
    }
    // Helper: writer identity matches authenticated user
    function isWriter() {
      return request.resource.data._updatedBy == request.auth.token.email;
    }

    match /hamms/mainData {
      allow read, delete: if isNamedUser();
      allow create, update: if false;
    }
    match /hammsStores/{store}/records/{docId} {
      allow read: if isNamedUser();
      // Create: named user, valid store, record must carry their identity
      allow create: if isNamedUser()
        && store in ['wo','assets','inventory','issuance','waste','safety',
                     'projects','waterLogs','waterTank','effluent',
                     'medWasteProd','wwProd','censusLog','waterSettings',
                     'energyBills']
        && request.resource.data.keys().size() < 100
        && (!('_v' in request.resource.data) || request.resource.data._v is int)
        && (!('_updatedAt' in request.resource.data) || request.resource.data._updatedAt is int)
        && isWriter();
      // Update: same checks + version must increment monotonically
      allow update: if isNamedUser()
        && store in ['wo','assets','inventory','issuance','waste','safety',
                     'projects','waterLogs','waterTank','effluent',
                     'medWasteProd','wwProd','censusLog','waterSettings',
                     'energyBills']
        && request.resource.data.keys().size() < 100
        && (!('_v' in request.resource.data) || request.resource.data._v is int)
        && (!('_updatedAt' in request.resource.data) || request.resource.data._updatedAt is int)
        && isWriter()
        && (!('_v' in request.resource.data) || !('_v' in resource.data)
            || request.resource.data._v >= resource.data._v);
      // Delete: named user in a valid store, must match record writer or unassigned legacy record
      allow delete: if isNamedUser()
        && store in ['wo','assets','inventory','issuance','waste','safety',
                     'projects','waterLogs','waterTank','effluent',
                     'medWasteProd','wwProd','censusLog','waterSettings',
                     'energyBills']
        && (!('_updatedBy' in resource.data) || resource.data._updatedBy == request.auth.token.email);
    }
    match /hammsMeta/state {
      allow read: if isNamedUser();
      allow write: if isNamedUser()
        && request.resource.data.keys().size() < 50
        && (!('inpatientToday' in request.resource.data)
            || request.resource.data.inpatientToday is int);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
