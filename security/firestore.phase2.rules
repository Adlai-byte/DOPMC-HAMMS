rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function named() { return request.auth != null && request.auth.token.email is string; }
    function active() {
      return named() && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in ['staff','admin']
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.facilityId == 'dopmc';
    }
    function admin() { return active() && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'admin'; }
    function validStore(s) { return s in ['wo','assets','inventory','issuance','waste','safety','projects','waterLogs','waterTank','effluent','medWasteProd','wwProd','censusLog','waterSettings','energyBills']; }
    match /staff/{uid} {
      allow get: if named() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow write: if false;
    }
    match /hammsStores/{store}/records/{docId} {
      allow read: if active() && validStore(store);
      // All mutations go through the trusted command service, including for admins.
      allow write: if false;
    }
    match /hamms/mainData { allow read: if active(); allow write: if false; }
    match /hammsMeta/state { allow read: if active(); allow write: if false; }
    match /system/{id} { allow read: if active(); allow write: if false; }
    match /energySettings/{id} { allow read: if active(); allow write: if false; }
    match /auditEvents/{id} { allow read: if admin(); allow write: if false; }
    match /operationResults/{id} { allow read: if active() && resource.data.actorUid == request.auth.uid; allow write: if false; }
    match /privilegedJobs/{id} { allow read: if admin(); allow write: if false; }
    match /inventoryMovements/{id} { allow read: if active(); allow write: if false; }
    match /inventoryLedgers/{id} { allow read: if active(); allow write: if false; }
    match /correctionProposals/{id} { allow read: if admin(); allow write: if false; }
    match /locations/{id} { allow read: if active(); allow write: if false; }
    match /relationshipProposals/{id} { allow read: if admin(); allow write: if false; }
    match /assetCodes/{id} { allow read, write: if false; }
    match /energyFactors/{id} { allow read: if active(); allow write: if false; }
    match /energyFactorVersions/{id} { allow read, write: if false; }
    match /energyBillPeriods/{id} { allow read: if active(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
